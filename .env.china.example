# Jev-Interaction, mainland-China providers (中国大陆最佳实践配置).
# One Alibaba Cloud Bailian (DashScope) key covers speech recognition, speech synthesis and the Qwen language model.
# Copy to .env (or run ./scripts/setup.sh --china).

# Jev judges every interaction decision. If api.typesafe.ai is slow or unreachable from your network, set
# HTTPS_PROXY for this process (httpx and websockets both honour it).
JEV_API_KEY=
JEV_MODEL=jev-latest

# The responder. Qwen through DashScope's OpenAI-compatible mode (same key as below):
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
# Or DeepSeek:  LLM_BASE_URL=https://api.deepseek.com/v1   LLM_MODEL=deepseek-chat
# Or Doubao (Volcengine Ark):  LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3   LLM_MODEL=<your endpoint id>

# Speech: Paraformer realtime recognition + CosyVoice synthesis (Alibaba Cloud Bailian, Beijing region)
ASR_PROVIDER=dashscope
TTS_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_ASR_MODEL=paraformer-realtime-v2
DASHSCOPE_TTS_MODEL=cosyvoice-v2
# Default voice; profiles can set their own (voices: {dashscope: ...}). cosyvoice-v2: longxiaochun_v2 gentle female,
# longwan_v2 Mandarin female, longcheng_v2 bright male
DASHSCOPE_TTS_VOICE=longxiaochun_v2

# Timing preset: production | tested | default
JEV_PRESET=production
