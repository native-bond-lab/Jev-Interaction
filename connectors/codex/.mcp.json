{
  "mcpServers": {
    "jev": {
      "command": "/bin/sh",
      "args": [
        "./bin/connect.sh"
      ],
      "cwd": ".",
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 3600,
      "default_tools_approval_mode": "approve",
      "env_vars": [
        "PATH",
        "HOME",
        "JEV_INTERACTION_BIN",
        "JEV_HOME",
        "JEV_CODEX_BIN",
        "JEV_CONNECT_LOG",
        "JEV_LOCAL_AUDIO",
        "JEV_LOCAL_MIC",
        "JEV_LOCAL_SPEAKER",
        "HTTPS_PROXY",
        "HTTP_PROXY",
        "NO_PROXY",
        "ALL_PROXY"
      ]
    }
  }
}
