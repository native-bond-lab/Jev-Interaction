# Jev-Interaction, global providers. This is the setup the production engine runs today.
# Copy to .env (or run ./scripts/setup.sh, which asks for the keys).

# Jev judges every interaction decision (https://typesafe.ai)
JEV_API_KEY=
JEV_MODEL=jev-latest

# The responder: any OpenAI-compatible chat endpoint (xAI, OpenAI, DeepSeek, a local vLLM / Ollama server)
LLM_BASE_URL=https://api.x.ai/v1
LLM_API_KEY=
LLM_MODEL=grok-4.3

# Speech: ElevenLabs Scribe realtime for recognition, ElevenLabs for synthesis
ASR_PROVIDER=elevenlabs
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_ASR_MODEL=scribe_v2_realtime_turbo
ELEVENLABS_TTS_MODEL=eleven_v4_turbo

# Timing preset: production (what we run) | tested (plus the benchmark knobs) | default
JEV_PRESET=production
