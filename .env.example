# Jev-Interaction settings. The easiest way to fill these in is the setup steps on the page (jev-interaction serve,
# then open http://localhost:8080); this file is for Docker and for people who prefer editing it by hand.
# Pick your own providers. Two setups we recommend are at the bottom, to copy from if you like; cookbook/stacks.md
# says what each is good for. Model fields left out use the provider's own default.

# 1. Judge: Jev answers every interaction decision (https://typesafe.ai)
JEV_API_KEY=
JEV_MODEL=jev-latest

# 2. Language model: any OpenAI-compatible chat endpoint (xAI, OpenAI, DeepSeek, Qwen, Doubao, GLM, Kimi, OpenRouter,
# Groq, a local Ollama / vLLM server). Reasoning is switched off where the provider has a switch; anything else can be
# passed as JSON in LLM_EXTRA_BODY.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.7
# Preserve original newline boundaries. first_sentence is an opt-in segmentation experiment.
LLM_CHUNK_MODE=newline
# Reuse the LLM HTTP connection within a call; 0 restores one client per generation.
LLM_REUSE_CONNECTION=1

# 3. Speech recognition: elevenlabs | dashscope | doubao (or a plugin's provider)
ASR_PROVIDER=
# 4. Speech synthesis: elevenlabs | dashscope | doubao (or a plugin's provider). The language model is told how to write for
# the voice you pick (audio tags for ElevenLabs v3/v4, plain words otherwise).
TTS_PROVIDER=

# ElevenLabs (recognition and/or synthesis)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_ASR_MODEL=
# ELEVENLABS_TTS_MODEL=
# Forward each provider audio chunk immediately; 4096 restores the previous local buffer.
ELEVENLABS_TTS_CHUNK_BYTES=0
# Retain an HTTP pool for this call/voice; 0 restores one client per synthesis.
ELEVENLABS_TTS_REUSE_CONNECTION=1
# Start one same-origin metadata GET during call setup, using that pool. 0 disables prewarming.
# Speech cancels an unfinished warmup; setup never waits for it. Requires connection reuse.
ELEVENLABS_TTS_PREWARM=1
# Begin the first line's synthesis when text is eligible, before the browser GET. 0 restores lazy start.
# Playback, retries and byte ranges still share one bounded audio stream in either mode.
TTS_PREFETCH=1

# Alibaba Cloud Bailian / DashScope (recognition, synthesis, and Qwen through the same key)
DASHSCOPE_API_KEY=
# DASHSCOPE_ASR_MODEL=
# DASHSCOPE_TTS_MODEL=
# DASHSCOPE_TTS_VOICE=

# Doubao Voice: a speech-service key, separate from a ModelArk language-model key.
# Enable the streaming ASR and TTS resources in the speech console before testing.
DOUBAO_API_KEY=
# Optional per-node keys override the shared speech key.
# DOUBAO_ASR_API_KEY=
# DOUBAO_TTS_API_KEY=
# Legacy speech console authentication instead: DOUBAO_APP_ID + DOUBAO_ACCESS_TOKEN.
DOUBAO_ASR_RESOURCE_ID=
DOUBAO_TTS_RESOURCE_ID=
DOUBAO_TTS_VOICE=
# DOUBAO_ASR_SILENCE_MS=350

# Timing preset: recommended (the timing our product runs on) | tested (plus the benchmark knobs) | default
JEV_PRESET=recommended

# Call logs in runs/ (for jev-interaction replay). Set 0 on a public demo.
# Includes stage timings; summarize without transcripts: python tools/latency_report.py "runs/call-*.jsonl"
JEV_RECORD_CALLS=1

# ---------------------------------------------------------------- recommended setups (copy what you want above)
# [global] Proven at scale in our product: grok-4.3 with reasoning off, Scribe v3 Live, eleven_v4_turbo.
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=grok-4.3
# ASR_PROVIDER=elevenlabs
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_ASR_MODEL=scribe_v3_live
# ELEVENLABS_TTS_MODEL=eleven_v4_turbo
#
# [china] A mainland China setup: one DashScope key for Qwen, Paraformer and CosyVoice. If api.typesafe.ai is slow
# from your network, set HTTPS_PROXY for this process.
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# ASR_PROVIDER=dashscope
# TTS_PROVIDER=dashscope
# DASHSCOPE_ASR_MODEL=paraformer-realtime-v2
# DASHSCOPE_TTS_MODEL=cosyvoice-v2
# DASHSCOPE_TTS_VOICE=longxiaochun_v2
#
# [direct-network test] DeepSeek + Doubao Voice + the public Jev endpoint.
# Keep API keys in .env or an ignored local profile; never commit them.
# JEV_URL=https://jev.amigos-robot.com/v1/systemone
# JEV_MODEL=jev-lite
# JEV_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-flash
# LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
# ASR_PROVIDER=doubao
# TTS_PROVIDER=doubao
# Set the authorized resource IDs and voice in the fields above.
