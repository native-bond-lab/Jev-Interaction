# Jev-Interaction settings. The easiest way to fill these in is the setup steps on the page (jev-interaction serve,
# then open http://localhost:8080); this file is for Docker and for people who prefer editing it by hand.
# Pick your own providers. Two reference setups we have run are at the bottom, to copy from if you like.

# 1. Judge: Jev answers every interaction decision (https://typesafe.ai)
JEV_API_KEY=
JEV_MODEL=jev-latest

# 2. Language model: any OpenAI-compatible chat endpoint (xAI, OpenAI, DeepSeek, Qwen, Doubao, GLM, Kimi, OpenRouter,
# Groq, a local Ollama / vLLM server). Reasoning is switched off where the provider has a switch; anything else can be
# passed as JSON in LLM_EXTRA_BODY.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.7

# 3. Speech recognition: elevenlabs | dashscope (or a plugin's provider)
ASR_PROVIDER=
# 4. Speech synthesis: elevenlabs | dashscope (or a plugin's provider). The language model is told how to write for
# the voice you pick (audio tags for ElevenLabs v3/v4, plain words otherwise).
TTS_PROVIDER=

# ElevenLabs (recognition and/or synthesis)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_ASR_MODEL=scribe_v2_realtime_turbo
ELEVENLABS_TTS_MODEL=eleven_v4_turbo

# Alibaba Cloud Bailian / DashScope (recognition, synthesis, and Qwen through the same key)
DASHSCOPE_API_KEY=
DASHSCOPE_ASR_MODEL=paraformer-realtime-v2
DASHSCOPE_TTS_MODEL=cosyvoice-v2
DASHSCOPE_TTS_VOICE=longxiaochun_v2

# Timing preset: production (what we run) | tested (plus the benchmark knobs) | default
JEV_PRESET=production

# Call logs in runs/ (for jev-interaction replay). Set 0 on a public demo.
JEV_RECORD_CALLS=1

# ---------------------------------------------------------------- reference setups (copy what you want above)
# [global] What we run in production: grok-4.3 with reasoning off, Scribe v2 realtime, eleven_v4_turbo.
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=grok-4.3
# ASR_PROVIDER=elevenlabs
# TTS_PROVIDER=elevenlabs
#
# [china] A mainland China setup: one DashScope key for Qwen, Paraformer and CosyVoice. If api.typesafe.ai is slow
# from your network, set HTTPS_PROXY for this process.
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# ASR_PROVIDER=dashscope
# TTS_PROVIDER=dashscope
