    family-names: Yang
    affiliation: "Native Bond Lab"
  - given-names: Zipeng
    family-names: Wu
    affiliation: "Native Bond Lab"
repository-code: "https://github.com/native-bond-lab/Jev-Interaction"
url: "https://huggingface.co/spaces/pupunpu/Jev-Interaction"
license: Apache-2.0
version: "0.3.0"
date-released: "2026-11-20"
keywords:
  - full-duplex
  - spoken dialogue
  - turn-taking
  - voice agents
  - LLM-as-judge
