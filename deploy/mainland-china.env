# Jev-Interaction for callers in mainland China: the setup that measured best there. Copy it to .env and fill in the
# two values marked <...>:
#
#     cp deploy/mainland-china.env .env        # then: jev-interaction serve   (or: docker compose up)
#
# One Alibaba Cloud Bailian key serves all four nodes: its decision model as the judge, Qwen, Paraformer, CosyVoice.
# Every service below answers from inside the mainland. What we measured and how: cookbook/stacks.md
# ("Recommended (mainland China)" and "The judge on the mainland"); the numbers quoted here come from there.

# ---- the judge: Bailian decision-model-preview, with the question wording made for it
# api.typesafe.ai (Jev) answers 451 from mainland networks. Measured 2026-11-20 from a mainland network on 0.3.0's
# questions (tools/judge_bench.py --held-out, and --decisions --held-out): "have they finished" right on 90% of 80
# held-out pauses (ranking 0.96), taking 90% of the finished turns and speaking into 15% of the unfinished ones at its
# line; both talking 100%, a silence 95%, "something is due" while listening 96%, which pace 92%, cutting in 88% (the
# last two with this judge's own wording of the pace and its own line for cutting in, 0.2; Jev is at 100% on both).
# One request: about 140 -> 180 ms for 1 -> 11 questions.
# The address is your workspace's own: the llm-... / <workspace-id> host shown as "API Host" when you create the key.
JEV_API_KEY=<your Bailian key>
JEV_URL=https://<your-workspace-id>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/systemone
JEV_MODEL=decision-model-preview
JEV_PROVIDER=bailian
JEV_TURN_QUESTION=last_words
# JEV_PROVIDER=bailian also takes the turn at p(finished) 0.725 instead of 0.5 (Config.finished_min) and cuts in at
# p(sparring) 0.2 (Config.sparring_min): this judge's numbers sit nearer the middle. Nothing is drawn.

# ---- the language model: Qwen through the same key (reasoning is switched off by the adapter)
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=<your Bailian key>
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.7

# ---- recognition and the voice: Paraformer and CosyVoice through the same key
ASR_PROVIDER=dashscope
TTS_PROVIDER=dashscope
DASHSCOPE_API_KEY=<your Bailian key>
DASHSCOPE_ASR_MODEL=paraformer-realtime-v2
DASHSCOPE_TTS_MODEL=cosyvoice-v2
DASHSCOPE_TTS_VOICE=longxiaochun_v2

# ---- the sound of the voice and the caller's voiceprint run on your own CPU. Their models download from Hugging
# Face on first use; where huggingface.co is out of reach, a mirror:
# HF_ENDPOINT=https://hf-mirror.com

JEV_PRESET=recommended
JEV_RECORD_CALLS=1

# ---- another judge that reads the engine's own wording, if you would rather: Volcengine Ark System One (beta).
# Right on 95% of the same pauses (ranking 0.99), but about 330 -> 450 ms a request, with outliers of seconds.
# JEV_API_KEY=<your Ark key>
# JEV_URL=https://ark.cn-beijing.volces.com/api/v1/systemone
# JEV_MODEL=doubao-seed-2-1-lite-260915
# JEV_HEADERS={"ark-beta-systemone-api": "true"}
# JEV_PROVIDER=jev
# JEV_TURN_QUESTION=engine
